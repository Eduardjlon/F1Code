// Codigo Andante generado por f1code (Grupo 1) desde 07_carrera.f1

numero f1_fin = 0;

// carrera.f1 — Ejemplo completo de F1Code
// Simula una carrera: se pide el numero de vueltas y se reporta el progreso.
numero vueltas = 0;   // declaracion entera
decimal combustible = 100.0;   // declaracion real
numero vuelta = 1;
leer vueltas;   // entrada de datos
/* Si la carrera es muy larga, avisamos;
   si no, mostramos el combustible inicial */
virar (vueltas > 50) inicio
    caminar 999;
final
sino inicio
    caminar combustible;
final
historia (f1_fin == 0 && vuelta <= vueltas) inicio
    // ciclo
    avanzar combustible = combustible - (2.5 * 3);   // precedencia: * antes que -
    caminar vuelta;
    virar (combustible < 10.0) inicio
        // se acaba el combustible
        caminar 0;
        avanzar f1_fin = 1;   // termina el programa
    final
    virar (f1_fin == 0) inicio
        avanzar vuelta = vuelta + 1;
    final   // incremento compuesto
final
virar (f1_fin == 0) inicio
    caminar (vuelta - 1) * 2;   // parentesis fuerzan el orden
final
